{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionux.local/schemas/agent/v3/transaction.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    },
    "reviewFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "authorized-fixture",
        "applying",
        "applied",
        "verifying",
        "verified",
        "failed",
        "rolled-back",
        "needs-manual-review"
      ]
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "status": {
            "enum": [
              "authorized-fixture",
              "applying",
              "applied",
              "verifying",
              "verified",
              "failed",
              "rolled-back",
              "needs-manual-review"
            ]
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "time": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "detail",
          "time"
        ]
      },
      "maxItems": 190,
      "minItems": 1
    },
    "proof": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "beforeHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "finalHash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "beforeHash",
            "finalHash"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "reviewFingerprint",
    "status",
    "events",
    "proof",
    "fingerprint"
  ]
}
