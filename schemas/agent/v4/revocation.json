{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionux.local/schemas/agent/v4/revocation.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim",
    "signature"
  ],
  "properties": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "issuer",
        "kid",
        "audience",
        "nonce",
        "grantEvent",
        "issuedAt",
        "reason"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "kind": {
          "const": "fixture-revocation"
        },
        "issuer": {
          "const": "motionux-fixture-operator"
        },
        "kid": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audience": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "nonce": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "grantEvent": {
          "type": "string",
          "pattern": "^[a-f0-9]{32}$"
        },
        "issuedAt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "const": "operator-revoked"
        }
      }
    },
    "signature": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{86}$"
    }
  }
}
