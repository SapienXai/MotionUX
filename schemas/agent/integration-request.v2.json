{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://motionux.local/schemas/agent/integration-request.v2.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "mode": {
      "const": "fixture-only"
    },
    "planPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "requestPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "choiceId": {
      "type": "string",
      "pattern": "^[a-z0-9-]{1,90}$"
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "planPath",
    "requestPath",
    "choiceId"
  ],
  "additionalProperties": false
}
