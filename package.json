{
  "name": "sapienx-motionux-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "node scripts/studio/start.mjs",
    "studio:doctor": "node scripts/studio/v11/doctor.mjs",
    "studio:thumbnails": "node scripts/studio/v11/thumbnails.mjs",
    "studio:backup": "python3 scripts/studio/v11/backup.py backup",
    "studio:restore": "python3 scripts/studio/v11/backup.py restore",
    "studio:verify": "node scripts/studio/verify.mjs && node scripts/studio/v11/verify.mjs",
    "studio:scale": "node scripts/originals/benchmark.mjs scale",
    "studio:endurance": "node scripts/originals/benchmark.mjs endurance",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "registry:build": "shadcn build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --test tests/*.test.mjs",
    "test": "npm run test:brain && npm run test:agent && npm run test:agent:v2 && npm run test:agent:v3 && npm run mcp:test && playwright test",
    "test:usage": "node scripts/recipe-registry.mjs --check && node scripts/update-usage-templates.mjs --check && node scripts/verify-usage.mjs",
    "verify": "npm run lint && npm run typecheck && npm run registry:build && npm run test:unit && npm run test:usage && npm run build && npm test",
    "sources:inspect": "node scripts/v9/inspect-reference.mjs",
    "sources:prepare": "node scripts/v9/prepare.mjs && node scripts/v9/prepare-designbookmark.mjs",
    "sources:prepare:v12": "node scripts/v9/prepare.mjs --v12",
    "sources:serve": "node scripts/v9/serve.mjs",
    "studio:verify:v12": "node scripts/v12/verify.mjs",
    "originals:expand:v13": "node scripts/originals/prepare.mjs v13",
    "originals:expand:v14": "node scripts/originals/prepare.mjs v14",
    "originals:verify:v13": "node scripts/originals/verify.mjs v13",
    "originals:verify:v14": "node scripts/originals/verify.mjs v14",
    "originals:benchmark": "node scripts/originals/benchmark.mjs",
    "originals:status": "node scripts/studio/v11/doctor.mjs",
    "originals:verify-consumers": "node scripts/originals/consumer-check.mjs",
    "originals:index": "node scripts/originals/index-tools.mjs",
    "brain:index": "node scripts/brain/cli.mjs index",
    "brain:doctor": "node scripts/brain/cli.mjs doctor",
    "brain:search": "node scripts/brain/cli.mjs search",
    "brain:recommend": "node scripts/brain/cli.mjs recommend",
    "brain:inspect": "node scripts/brain/cli.mjs inspect",
    "brain:evaluate": "node scripts/brain/cli.mjs evaluate",
    "test:brain": "node --test scripts/brain/*.test.mjs",
    "brain:benchmark": "node --expose-gc scripts/brain/benchmark.mjs",
    "agent:inspect": "node scripts/agent/cli.mjs inspect",
    "agent:plan": "node scripts/agent/cli.mjs plan",
    "agent:doctor": "node scripts/agent/cli.mjs doctor",
    "agent:evaluate": "node scripts/agent/cli.mjs evaluate",
    "agent:benchmark": "node scripts/agent/cli.mjs benchmark",
    "test:agent": "node --test scripts/agent/*.test.mjs",
    "agent:v2:doctor": "node scripts/agent/v2/cli.mjs doctor",
    "agent:v2:review": "node scripts/agent/v2/cli.mjs review",
    "agent:v2:dry-run": "node scripts/agent/v2/cli.mjs dry-run",
    "agent:v2:apply": "node scripts/agent/v2/cli.mjs apply",
    "agent:v2:verify": "node scripts/agent/v2/cli.mjs verify",
    "agent:v2:status": "node scripts/agent/v2/cli.mjs status",
    "agent:v2:rollback": "node scripts/agent/v2/cli.mjs rollback",
    "agent:v2:evaluate": "node scripts/agent/v2/cli.mjs evaluate",
    "test:agent:v2": "node --test scripts/agent/v2/*.test.mjs",
    "studio:storage:audit": "node scripts/studio/storage-audit.mjs",
    "mcp:serve": "node scripts/mcp/server.mjs",
    "mcp:doctor": "node scripts/mcp/doctor.mjs",
    "mcp:test": "node --test scripts/mcp/*.test.mjs scripts/studio/storage-audit.test.mjs",
    "mcp:evaluate": "node scripts/mcp/evaluate.mjs",
    "mcp:verify:codex": "node scripts/mcp/verify-codex.mjs",
    "agent:v3:doctor": "node scripts/agent/v3/cli.mjs doctor",
    "agent:v3:review": "node scripts/agent/v3/cli.mjs review",
    "agent:v3:dry-run": "node scripts/agent/v3/cli.mjs dry-run",
    "agent:v3:fixture-evaluate": "node scripts/agent/v3/cli.mjs fixture-evaluate",
    "agent:v3:status": "node scripts/agent/v3/cli.mjs status",
    "agent:v3:rollback": "node scripts/agent/v3/cli.mjs rollback",
    "agent:v3:evaluate": "node scripts/agent/v3/cli.mjs evaluate",
    "agent:v3:seed-cache": "node scripts/agent/v3/cache.mjs",
    "test:agent:v3": "node --test scripts/agent/v3/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "lucide-react": "0.454.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "eslint": "9.39.5",
    "semver": "7.8.6",
    "shadcn": "4.23.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8"
  }
}
